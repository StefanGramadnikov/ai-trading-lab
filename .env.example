# Local examples only. Never use production or financial credentials here.
ATL_EXECUTION_MODE=PAPER_ONLY
POSTGRES_USER=ai_trading_lab
POSTGRES_PASSWORD=local_example_only
POSTGRES_DB=ai_trading_lab
ATL_DATABASE_URL=postgresql+psycopg://ai_trading_lab:local_example_only@localhost:5432/ai_trading_lab
ATL_DATABASE_TIMEOUT_SECONDS=2
# Separate test database, created explicitly; never point tests at application data.
ATL_TEST_DATABASE_URL=postgresql+psycopg://ai_trading_lab:local_example_only@localhost:5432/ai_trading_lab_test

# Inference is opt-in. Use personal API credentials locally only; never commit them.
ATL_AI_ENABLED=false
# Paid admission is disabled until a separately reviewed aggregate cap and prices are configured.
# The USD ceiling includes all paid envelopes in this database, without an automatic reset.
ATL_AI_TOTAL_LIMIT_USD=0
ATL_AI_REVIEWED_PRICES=[]
# ATL_OPENAI_API_KEY=replace_locally
# ATL_XAI_API_KEY=replace_locally
# ATL_ANTHROPIC_API_KEY=replace_locally

# Optional local read-only dashboard; configure BOTH to enable reporting.
# Replace with your own password (at least 12 ASCII characters). Keep API loopback-only.
ATL_REPORTING_USERNAME=
ATL_REPORTING_PASSWORD=
# Outbound Telegram is disabled. Real delivery requires separate approval.
ATL_TELEGRAM_ENABLED=false
ATL_TELEGRAM_BOT_TOKEN=
ATL_TELEGRAM_CHAT_ID=

# Optional worker is not started by default. No operational activation yet.
# Supply an explicitly reviewed OBSERVED session + finite invocation caps.
ATL_RUNTIME_SESSION_ID=
ATL_RUNTIME_CYCLES=1
ATL_RUNTIME_SECONDS=60
