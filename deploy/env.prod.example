# Copy to /opt/atl/.env.prod on the server, then: chmod 600 /opt/atl/.env.prod
# Never commit the real file. Paper trading only: the execution mode is fixed in compose.prod.yaml.

# Database (used only inside the Compose network). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_a_long_random_value
POSTGRES_USER=ai_trading_lab
POSTGRES_DB=ai_trading_lab

# Tag for the built image, for example the git tag or short commit that was deployed.
ATL_IMAGE_TAG=local

# --- AI strategy (leave as is to run rules + benchmark only; nothing is asked or paid) ---------
# Turn on only after the checks in docs/30-deployment-runbook.md, section "Activating the AI".
ATL_AI_ENABLED=false
# Hard ceiling, USD, counted across everything ever spent from this database.
ATL_AI_TOTAL_LIMIT_USD=0
# The model, pinned for the whole run. Supported: gpt-6.1-sol (default), gpt-5.6-terra. It needs its own
# entry in the price line below, or the AI strategy stays off (`ai_price_not_reviewed`).
ATL_AI_MODEL=gpt-6.1-sol
# One JSON line, single-quoted, the model's price you verified on the provider's page, e.g.
# ATL_AI_REVIEWED_PRICES='[{"provider":"openai","model":"MODEL","input_per_million":"X","output_per_million":"Y","source_url":"https://...","verified_at_utc":"2026-10-27T00:00:00Z","version":"2026-10-27"}]'
ATL_AI_REVIEWED_PRICES=[]
# How many days that verified price stays valid (the run is unattended).
ATL_AI_PRICE_MAX_AGE_DAYS=14
# A SEPARATE key for this server, created with a hard monthly spending limit at the provider.
ATL_OPENAI_API_KEY=

# --- Dashboard (reached only through an SSH tunnel; see docs/30-deployment-runbook.md) ---------
# Both are generated ON THE SERVER, never typed into chat or committed:
#   docker compose -f compose.prod.yaml --env-file /opt/atl/.env.prod run --rm --no-deps dashboard /app/.venv/bin/atl-dashboard hash-password
#   docker compose -f compose.prod.yaml --env-file /opt/atl/.env.prod run --rm --no-deps dashboard /app/.venv/bin/atl-dashboard make-secret
# Leave both empty and the dashboard refuses every sign-in.
ATL_DASHBOARD_PASSWORD_HASH=
ATL_DASHBOARD_SESSION_SECRET=
# Minutes of inactivity before the page signs you out.
ATL_DASHBOARD_IDLE_MINUTES=30

# --- Telegram alerts (docs/30 section 9c). You create the bot; the token never goes in chat. -----
# 1. In Telegram, open @BotFather, send /newbot, follow the steps, copy the token it gives you.
# 2. Send any message to your new bot. 3. Run `atl-alerts find-chat` (docs/30) to get your chat id.
# 4. Put both below, set ATL_TELEGRAM_ENABLED=true, then `docker compose ... up -d alerts`.
ATL_TELEGRAM_ENABLED=false
ATL_TELEGRAM_BOT_TOKEN=
ATL_TELEGRAM_CHAT_ID=

